{
  "name": "ShuttInk",
  "slug": "shuttink",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#1D6FA3"
  },
  "plugins": [
    "expo-status-bar",
    "expo-font",
    [
      "expo-image-picker",
      {
        "cameraPermission": "ShuttInk uses your camera so you can snap your daily and weekly photos.",
        "photosPermission": "ShuttInk needs your photos so you can submit pictures you've already taken."
      }
    ],
    "expo-sharing",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon.png",
        "imageWidth": 220,
        "resizeMode": "contain",
        "backgroundColor": "#1D6FA3"
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "db93b5fd-a9f3-47c0-b0ff-44406b5fd945"
    }
  },
  "owner": "shuttink-sample",
  "updates": {
    "url": "https://u.expo.dev/db93b5fd-a9f3-47c0-b0ff-44406b5fd945"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#1D6FA3"
    },
    "package": "app.shuttink"
  },
  "ios": {
    "bundleIdentifier": "app.shuttink",
    "supportsTablet": false,
    "config": {
      "usesNonExemptEncryption": false
    }
  }
}
